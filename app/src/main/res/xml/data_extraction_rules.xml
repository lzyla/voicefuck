<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup & device-transfer rules: never move the encrypted
     API key off the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
